{
  "name": "side-quest-life",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "assets:timeframes": "node ./scripts/sync-timeframe-backgrounds.cjs",
    "e2e:web": "playwright test --config=playwright.config.ts",
    "e2e:web:smoke": "playwright test --config=playwright.config.ts --grep @smoke",
    "e2e:native": "node ./scripts/e2e/run-maestro.cjs",
    "e2e:native:smoke": "node ./scripts/e2e/run-maestro.cjs --smoke",
    "e2e:report": "node ./scripts/e2e/generate-bug-report.cjs",
    "e2e:all": "node ./scripts/e2e/run-journeys.cjs",
    "e2e:smoke": "node ./scripts/e2e/run-journeys.cjs --smoke",
    "test:unit": "node --test \"tests/unit/**/*.test.mts\""
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.49.4",
    "date-fns": "^4.1.0",
    "expo": "~55.0.32",
    "expo-build-properties": "~55.0.18",
    "expo-calendar": "~55.0.19",
    "expo-constants": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-image-picker": "~55.0.24",
    "expo-linking": "~55.0.17",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.33",
    "expo-web-browser": "~55.0.20",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-paper": "^5.15.1",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/react": "~19.2.10",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
