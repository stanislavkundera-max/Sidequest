{
  "name": "side-quest-life",
  "main": "expo-router/entry",
  "version": "1.1.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "assets:timeframes": "node ./scripts/sync-timeframe-backgrounds.cjs",
    "e2e:web": "playwright test --config=playwright.config.ts",
    "e2e:web:smoke": "playwright test --config=playwright.config.ts --grep @smoke",
    "e2e:native": "node ./scripts/e2e/run-maestro.cjs",
    "e2e:native:smoke": "node ./scripts/e2e/run-maestro.cjs --smoke",
    "e2e:report": "node ./scripts/e2e/generate-bug-report.cjs",
    "e2e:all": "node ./scripts/e2e/run-journeys.cjs",
    "e2e:smoke": "node ./scripts/e2e/run-journeys.cjs --smoke",
    "test:unit": "node --test \"tests/unit/**/*.test.mts\""
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.49.4",
    "date-fns": "^4.1.0",
    "expo": "~58.0.17",
    "expo-build-properties": "~58.0.11",
    "expo-calendar": "~58.0.6",
    "expo-constants": "~58.0.13",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.25",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.18",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-paper": "^5.15.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/react": "~19.3.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
