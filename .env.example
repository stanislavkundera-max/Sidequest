# Copy this file to .env and fill in values from Supabase: Project Settings → API.
# Restart Expo after changing env vars.

# Project URL — must match Supabase Dashboard → Settings → API → Project URL exactly
# (wrong subdomain = "Failed to fetch" in the browser; no trailing slash)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# anon public key (safe for client apps; never commit the service_role key)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — development only (__DEV__): auto sign-in so you skip the sign-in screen.
# Create a test user in Supabase Auth, then set both (never commit real passwords).
# EXPO_PUBLIC_DEV_LOGIN_EMAIL=dev@example.com
# EXPO_PUBLIC_DEV_LOGIN_PASSWORD=your-dev-password
