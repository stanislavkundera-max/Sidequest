{
  "name": "side-quest-life",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "assets:timeframes": "node ./scripts/sync-timeframe-backgrounds.cjs",
    "e2e:web": "playwright test --config=playwright.config.ts",
    "e2e:web:smoke": "playwright test --config=playwright.config.ts --grep @smoke",
    "e2e:native": "node ./scripts/e2e/run-maestro.cjs",
    "e2e:native:smoke": "node ./scripts/e2e/run-maestro.cjs --smoke",
    "e2e:report": "node ./scripts/e2e/generate-bug-report.cjs",
    "e2e:all": "node ./scripts/e2e/run-journeys.cjs",
    "e2e:smoke": "node ./scripts/e2e/run-journeys.cjs --smoke"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.49.4",
    "date-fns": "^4.1.0",
    "expo": "~54.0.37",
    "expo-calendar": "~15.0.8",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-paper": "^5.15.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/react": "~19.1.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
